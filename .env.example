# Copy to .env (repo root) and adjust. Loaded by docker-compose and by the
# backend, which looks for .env in its working directory and in the parent -
# so `make run-backend` picks this file up. Real env vars always win.

# ── Postgres + Apache AGE (graph core) ───────────────────────────────
POSTGRES_USER=perspective
POSTGRES_PASSWORD=perspective
POSTGRES_DB=perspectivegraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# libpq sslmode for the DB connection (it carries the attack map). The bundled
# Postgres has no TLS so the default is "disable"; for a managed/external DB use
# "require" (encrypt) or "verify-full" (encrypt + verify the server cert; mount the
# CA and set POSTGRES_DSN with sslrootcert for full control).
POSTGRES_SSLMODE=disable
# Escape hatch: set a full libpq DSN and the builder above is bypassed entirely
# (POSTGRES_HOST/PORT/USER/PASSWORD/DB/SSLMODE are then ignored). Use it when you
# need parameters the builder does not expose, e.g. a verified TLS chain:
#   POSTGRES_DSN=host=db.example.com port=5432 user=pg dbname=perspectivegraph \
#     sslmode=verify-full sslrootcert=/etc/ssl/certs/rds-ca.pem
POSTGRES_DSN=
# AGE graph name created on startup
AGE_GRAPH_NAME=perspective

# ── NATS JetStream (event bus) ───────────────────────────────────────
NATS_URL=nats://localhost:4222
NATS_STREAM=PERSPECTIVE
NATS_SUBJECT=perspective.events.*
# NATS transport security (file paths, off by default). For a TLS-enabled NATS use
# a tls:// NATS_URL; NATS_TLS_CA trusts a private CA, NATS_TLS_CERT + NATS_TLS_KEY
# add a client cert for mutual TLS. Leave empty in a service mesh (it wraps it).
NATS_TLS_CA=
NATS_TLS_CERT=
NATS_TLS_KEY=

# ── HTTP servers ─────────────────────────────────────────────────────
# GraphQL API / BFF
API_ADDR=:8080
# Ingestion webhook receiver
INGEST_ADDR=:8081
# In-app TLS for the API + ingest servers. Set BOTH to a cert + key (PEM) and the
# servers speak HTTPS (TLS >= 1.2) directly; empty (default) serves plain HTTP and
# expects TLS to terminate at a reverse proxy / ingress in front.
TLS_CERT_FILE=
TLS_KEY_FILE=

# ── Analyzer ─────────────────────────────────────────────────────────
# How often the attack-path analyzer re-scans the graph
ANALYZER_INTERVAL=30s
# Max attack-path length (bounds the path search). Real attack chains are short.
ANALYZER_MAX_HOPS=12
# Compute critical paths in the database (Apache AGE Cypher) instead of the
# default in-process Dijkstra. OFF by default: AGE has no weighted shortest-path,
# so this enumerates paths (variable-length match) - unbounded in the worst case
# on dense/cyclic graphs. It's safe-railed (statement_timeout + LIMIT, with a
# fallback to Dijkstra on timeout) but reserved for graphs known to be bounded.
# Dijkstra is polynomial and the right default for the per-pass "all paths" scan.
ANALYZER_DB_PATHS=false
# Scale knobs. ANALYZER_WORKERS bounds the goroutines that fan out the per-seed
# shortest-path searches each pass (0 = auto = number of CPUs); the result is
# identical regardless, so this only trades CPU for pass latency on a graph with
# many internet-exposed entry points. ANALYZER_INCREMENTAL, when true, keeps the
# graph resident and patches it with just the per-pass delta (elements changed
# since the last pass) instead of re-reading everything - the fetch-cost win on a
# large AGE graph; OFF by default (it trades memory for fetch cost and is a no-op
# for stores without delta support). A full re-read still happens on the first
# pass, after a prune, and periodically as a self-healing safety net.
ANALYZER_WORKERS=0
ANALYZER_INCREMENTAL=false

# Attacker-profile mixture. The path score also gets marginalized over a latent
# attacker capability (commodity / criminal / apt): S(P) = Σ P(c)·∏ p(e|c). This
# conditions the independence assumption on a profile and reintroduces the
# correlation the bare product drops, yielding a per-profile breakdown ("72% vs an
# APT, 18% vs commodity"). Retune the threat-model priors here (names match the
# built-ins; values are renormalized). Empty keeps the defaults (0.5/0.35/0.15).
ATTACKER_PROFILE_PRIORS=

# EPSS -> conditional-traversal map: p(traverse|positioned) = EPSS^gamma, applied
# where EPSS sets an edge probability. EPSS is a marginal 30-day exploitation rate,
# not the conditional a positioned attacker needs; gamma < 1 lifts it (e.g. 0.5),
# gamma = 1 (default) keeps EPSS as-is. Opt-in - no fitted map is applied silently.
EPSS_TRAVERSAL_GAMMA=

# Credential-origin threat model (opt-in). Off by default the engine seeds paths only from
# internet exposure (the crisp "internet -> sensitive asset" headline). Set true to ALSO
# treat IAM users as seeds, on the premise their long-lived credentials could leak - which
# surfaces "if a credential leaks, what does it reach" (e.g. leaked keys -> IAM privesc ->
# admin) as scored paths, marked credential_exposed so the two origins stay separable.
SEED_IAM_USERS=

# ── AI-native layer ──────────────────────────────────────────────────
# Enables the /ai/* endpoints and the dashboard "AI assistant": natural-language
# Q&A over the attack graph, a board-level executive summary, and plain-English
# path explanations - grounded in the live attack paths. Two providers, picked by
# which credential is set (both transports hand-rolled, no SDK / no new deps):
#
#   • Anthropic (Claude) - preferred. Hand-rolled /v1/messages. Default model
#     claude-opus-5. Thinking is sent explicitly disabled: these calls summarise
#     data they are handed, and on the current Opus max_tokens caps thinking AND
#     response text together, so leaving it to the default would truncate answers
#     at the prose-sized AI_MAX_TOKENS. Raise AI_MAX_TOKENS first if you enable it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=
AI_MAX_TOKENS=
#   • HuggingFace (or any OpenAI-compatible endpoint) - the free / self-hosted
#     alternative, used ONLY when ANTHROPIC_API_KEY is empty. HF_TOKEN is a (free)
#     HuggingFace access token; HF_MODEL must be a chat model your token can reach
#     (default meta-llama/Llama-3.1-8B-Instruct); HF_BASE_URL defaults to the HF
#     Inference-Providers router and can point at any OpenAI-compatible API
#     (Together, Groq, a local Ollama, …). HUGGINGFACE_API_KEY is accepted as an
#     alias for HF_TOKEN.
HF_TOKEN=
HF_MODEL=
HF_BASE_URL=
#
# Empty for both (default) disables the feature. NOTE the trust boundary: the
# graph is the org's attack map, so a compacted view of it leaves to the chosen
# provider on each call - every AI call is audited (ai.query/ai.summary/ai.explain).

# ── GitHub workflow integration (action layer) ───────────────────────
# One token drives three things on GitHub: (1) a PR comment on the change that
# sits on a critical path, (2) a PR **commit status** `perspectivegraph/attack-
# paths` that goes red when the change opens an internet→crown-jewel path (make it
# a REQUIRED status check in branch protection to block the merge - shift-left),
# and (3) remediation-as-PR (POST /remediation/pr opens a branch+commit+PR with
# the generated fix). Needs `pull_requests: write` (+ `contents: write` and
# `statuses: write` for #2/#3). Leave empty → dry-run (logged, not posted).
GITHUB_TOKEN=
# Override for GitHub Enterprise, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com
# Force dry-run even when a token is set (logs instead of calling the API)
GITHUB_DRY_RUN=false
# Optional: deep-link a PR check back to the dashboard (target_url on the status).
DASHBOARD_URL=

# ── Where the engine may write (REQUIRED for GitHub/GitLab writes) ───
# Comma-separated repositories, each "owner/repo" or "owner/*". This bounds
# every outbound write: PR comments, merge-gate commit statuses and remediation
# PRs, on both GitHub and GitLab.
#
# It is required because the destination is otherwise taken from an ingested
# node property (`repo_slug`), and ingest is reachable by every scanner holding
# the shared HMAC key - the least-trusted credential here. Without this, one
# planted node makes the engine write to any repository the token can reach; a
# `success` commit status in a repo where this check is REQUIRED would open a
# merge gate. Empty ⇒ every real write is refused (dry-run still logs).
REPO_ALLOWLIST=

# ── GitLab MR commenter (action layer) ───────────────────────────────
# Personal/project access token with `api` scope. Empty → dry-run.
GITLAB_TOKEN=
GITLAB_API_URL=https://gitlab.com/api/v4
GITLAB_DRY_RUN=false

# ── OpenSearch full-text index (optional) ────────────────────────────
# Leave empty to disable. To enable with the full-stack compose, start both
# profiles (`docker compose --profile app --profile search up -d --build`) and
# set this to the in-network service URL so the backend container can reach it:
#   OPENSEARCH_URL=http://opensearch:9200
# For the host dev loop (make run-backend) use http://localhost:9200 instead.
OPENSEARCH_URL=

# ── Threat intel: CISA KEV + FIRST EPSS (optional) ───────────────────
# When on, CVE nodes are enriched with "exploited in the wild" (KEV) and the
# 30-day exploitation probability (EPSS), reweighting AFFECTS edges. Fetches
# live from the official feeds (cached); off → severity-derived weights stand.
THREATINTEL=off
# Optional overrides (air-gapped mirrors / testing); blank uses the official feeds.
KEV_FEED_URL=
EPSS_API_URL=

# ── KEV holdout: a calibration dataset that builds itself (optional) ──
# Needs THREATINTEL=true. Each pass SEALS a forecast for every CVE in the graph that
# is not yet known-exploited - recording what the engine predicted from that day's
# evidence - and grades it one window later against whether the CVE entered KEV in
# the meantime. Because the outcome did not exist when the forecast was sealed, the
# measurement is honest; grading today's score against today's KEV would just be the
# formula marking its own homework (a KEV CVE is assigned 0.95 by that formula).
# It appears as its OWN track in the calibration report and never moves the path
# scores: the graded event (CISA catalogues it) is narrower than the modelled one
# (an attacker traverses this hop). See backend/internal/kevholdout.
# ── Ingest coverage ──────────────────────────────────────────────────
# How long a collector may stay silent before the dashboard reports it as stale. This
# bounds what an empty board means: "no attack path" is only reassuring if the sources
# that would have shown one are still reporting. Default 24h.
COVERAGE_STALE_AFTER=

KEV_HOLDOUT=off
# Where sealed forecasts live. A window outlives most uptimes, so WITHOUT this
# nothing ever matures and the feature collects nothing.
KEV_HOLDOUT_PATH=
# Grading horizon. Defaults to 720h (30d) to match what EPSS itself forecasts.
KEV_HOLDOUT_WINDOW=

# ── Auth & multi-tenancy (optional; OPEN with a loud warning when unset) ──
# Deployment profile. "demo" (the default) keeps the open-by-default behaviour that
# makes `make demo` a single command. Set PG_ENV=production and the backend REFUSES
# TO START unless both the API and ingest are authenticated - so the permissive mode
# cannot be reached by forgetting to configure it. It only ever makes startup
# stricter, so it is safe to set everywhere that is not a demo.
PG_ENV=demo
# Ingest webhooks: HMAC-SHA256 of the request body (header
# X-PerspectiveGraph-Signature: sha256=<hex>). The secret never travels.
# INGEST_HMAC_SECRET is the default tenant's secret; INGEST_HMAC_SECRETS gives
# each tenant its own (the X-Tenant header selects it → real data isolation).
INGEST_HMAC_SECRET=
INGEST_HMAC_SECRETS=          # tenant-a:secretA,tenant-b:secretB
# GraphQL API bearer tokens. Each entry: token:role[:tenant[:expiry[:app1|app2]]]
#   - token : the bearer value, OR "sha256$<hex>" to store only its hash (so the
#             live secret never sits at rest in env/config). Hash: printf %s TOKEN | sha256sum
#   - role  : viewer | operator | admin
#   - tenant: optional (defaults to "default"; leave the field empty to keep it)
#   - expiry: optional YYYY-MM-DD; the token is rejected after that UTC day (rotation)
#   - apps  : optional pipe-separated app allowlist → the principal can only READ
#             attack paths / assets touching those apps (object-level RBAC).
# When set, GraphiQL is disabled and the dashboard must be built with VITE_API_TOKEN.
#   API_TOKENS=tok-a:viewer,tok-b:admin:globex,sha256$<hex>:viewer:default:2026-12-31:payments|web
API_TOKENS=
# OIDC/JWT (alongside or instead of static tokens): RS256 JWTs are verified
# against the JWKS; role/tenant/apps come from the "role"/"tenant"/"apps" claims
# (apps = JSON array or delimited string → same per-application read scoping).
# Fail-closed:
# if OIDC_JWKS_URL is set, OIDC_ISSUER and OIDC_AUDIENCE are REQUIRED (the backend
# refuses to start otherwise), so a verifier can't silently skip iss/aud checks.
# To try SSO end-to-end on a laptop with no cloud IdP, use the bundled demo
# Keycloak: `docker compose --profile app --profile sso up -d` and the values in
# docs/MANUAL.md "Trying SSO end-to-end on a laptop" (note OIDC_JWKS_URL uses
# keycloak:8080 and OIDC_ISSUER localhost:8088 - that split is correct).
OIDC_JWKS_URL=
OIDC_ISSUER=
OIDC_AUDIENCE=
# OIDC login (SPA-facing, not secret): drive the dashboard's "Sign in with SSO"
# button. The backend serves them at GET /auth/config so the dashboard renders the
# right login gate WITHOUT a rebuild (no token baked into the bundle - users sign
# in at runtime, the credential lives only in the tab's sessionStorage). Token
# validation still uses the JWKS/issuer/audience above; these only start the
# Authorization redirect. Leave unset to offer token-only login.
OIDC_CLIENT_ID=
OIDC_AUTHORIZE_URL=
# OIDC_TOKEN_URL: the IdP token endpoint. When set, the dashboard runs the full
# Authorization-Code + PKCE flow (code → token exchange, no client secret in the
# browser). When empty, it falls back to an implicit #access_token return. Your
# IdP must allow CORS from the dashboard origin on the token endpoint.
OIDC_TOKEN_URL=
OIDC_SCOPES=openid profile email
# OIDC_LOGOUT_URL: the IdP end-session endpoint. When set, "Sign out" performs an
# RP-initiated logout (ends the IdP session too) instead of just dropping the local
# token - without it the next SSO click silently re-authenticates. The dashboard
# origin must be a registered post-logout redirect URI on the IdP client.
OIDC_LOGOUT_URL=
# ── Who gets which role, once they have signed in ────────────────────
# Authenticating at the IdP proves WHO someone is. It does not decide what they may
# see, and this tool's data is a map of how to attack the org - so by default an SSO
# subject with no role claim gets NO access, and one of these has to grant it.
#
# OIDC_GROUP_ROLES is the one most estates want: enterprise IdPs keep authorisation
# in group membership, and neither Okta nor Entra mints a "role" claim unless someone
# builds a custom mapping inside the IdP first. Map directory groups onto roles here
# instead. A subject in several mapped groups gets the HIGHEST of them; an entry that
# does not parse is dropped and logged at error level rather than silently ignored.
#   OIDC_GROUP_ROLES=pg-viewers=viewer,pg-secops=operator,pg-admins=admin
OIDC_GROUP_ROLES=
# Claim names, for directories that namespace them (Auth0 and Entra commonly do).
# Empty keeps the defaults: role, groups, tenant, apps.
#   OIDC_GROUPS_CLAIM=https://acme.example/groups
OIDC_ROLE_CLAIM=
OIDC_GROUPS_CLAIM=
OIDC_TENANT_CLAIM=
OIDC_APPS_CLAIM=
# OIDC_DEFAULT_ROLE grants a role to EVERY subject the IdP authenticates, including
# ones in no mapped group. Empty (default) = no access without an explicit grant.
# Setting it is a deliberate widening and is logged as a warning at startup; it makes
# sense when the IdP application itself is already restricted to the right people.
#   OIDC_DEFAULT_ROLE=viewer
OIDC_DEFAULT_ROLE=
# Browser origins allowed to call the API cross-origin (comma-separated). Default
# is the Vite dev server + the docker-compose dashboard. Set to your dashboard's
# real origin in production; "*" allows any origin (not recommended); an empty
# value disables CORS entirely (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Data protection & abuse detection ───────────────────────────────
# STORE_ENCRYPTION_KEY encrypts the file-backed governance stores (suppressions,
# tickets, validations, history) AND the audit log at rest with AES-256-GCM, so a
# stolen volume/backup doesn't surrender the attack map + who-viewed-it in
# plaintext. A 64-hex-char value is the raw key; anything else is a passphrase.
# Empty → plaintext on disk. Generate one with: openssl rand -hex 32
STORE_ENCRYPTION_KEY=
# EXPORT_SIGNING_KEY (Ed25519, 64-hex seed) signs the OSCAL/SIEM exports with a
# detached signature so an auditor/SIEM can verify integrity + origin; fetch the
# public key at GET /export/pubkey. Empty → exports are unsigned.
# Generate one with: openssl rand -hex 32
EXPORT_SIGNING_KEY=
# GRAPHQL_INTROSPECTION: whether __schema/__type may be queried. Empty (the default)
# follows the auth posture - on while the API is open and GraphiQL is served, off once a
# credential is required. The schema is a complete map of every query, mutation and
# argument the service accepts, so an authenticated deployment does not hand it to every
# viewer-role token. Set "on" if you generate clients against an authenticated endpoint,
# "off" to disable it even in the open demo. __typename is never affected.
GRAPHQL_INTROSPECTION=
# TRUSTED_PROXY_CIDRS lists the reverse proxies / ingresses in front of this service
# (CIDRs or bare addresses, comma-separated). It decides whether X-Forwarded-For may be
# believed, and every per-IP control - rate limit, auth lockout, audit "remote" - uses
# the same answer.
#
# Empty (the default) = no proxy in front: those controls key on the connecting peer and
# the header is IGNORED. Keep it empty unless a proxy really is in front. Trusting the
# header blindly lets a brute force rotate it to evade the lockout entirely, and lets an
# attacker name a victim's address to lock that victim out (the lockout is checked before
# authentication, so it rejects their valid tokens too).
#
# Set it when you DO terminate at a proxy, or every request will look like it came from
# the proxy and one attacker's failures will lock out all users at once. Only hops added
# by these proxies are believed; anything a client prepends is discarded.
#   TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXY_CIDRS=
# AUTH_LOCKOUT_THRESHOLD: failed API auth attempts from one IP within 5 minutes
# before that IP is locked (HTTP 429) for 15 minutes and an alert is logged +
# audited. 0 disables. EXFIL_ALERT_THRESHOLD: attack-path views/exports by one
# principal within 5 minutes before an exfiltration alert fires. 0 disables.
# The lockout is DURABLE when GOVERNANCE_BACKEND=postgres: one already earned survives
# a restart or a deploy and is enforced by every replica (seen within 30s on the others,
# immediately on the one that set it). Only the lockout is stored, never the per-failure
# counter - a write per failed login would let the abuse drive the writes - so a restart
# still forgives partial progress toward the threshold. On the file backend the whole
# thing is per-process, which a deploy clears.
AUTH_LOCKOUT_THRESHOLD=50
EXFIL_ALERT_THRESHOLD=0

# ── Audit (optional; tamper-evident hash-chained log) ────────────────
# Append-only JSONL; each record links to the previous via SHA-256, so any
# edit is detectable. Records writes AND READS of the attack map - views of the
# attack paths/graph (with the path ids seen) and exports (OSCAL/NDJSON) - so you
# can answer "who saw, or exfiltrated, which attack paths". The tool is a map of
# how to breach the org, so its reads are governed too.
# Verify the chain with: perspectivegraph verify-audit <path>
# (or `verify-audit -postgres` when GOVERNANCE_BACKEND=postgres puts it in the DB).
AUDIT_LOG_PATH=              # e.g. /var/log/perspectivegraph/audit.log
# AUDIT_RETENTION: how long audit records are kept. Empty (the default) keeps them
# forever - which is not a retention policy, it is the absence of one, and it is what
# a data-protection review asks about first. Applies to the POSTGRES-backed chain
# (GOVERNANCE_BACKEND=postgres): the leader prunes records older than the window,
# oldest first, and leaves a checkpoint so what remains still verifies. The
# file-backed chain is rotated instead - stop, move the file aside, start - see
# docs/OPERATIONS.md "Retention and rotation".
AUDIT_RETENTION=             # e.g. 2160h (90 days)

# ── Temporal history (optional; file-backed) ─────────────────────────
# Per-path lifecycle (first/last seen, open/resolved → MTTR, reopen count) and a
# posture trend series, recorded each analyzer pass. Powers "open for N days",
# MTTR, regression detection and the dashboard trend sparkline. Empty → in-memory
# only (resets on restart, so path age and trends start over). Point it at a path
# on a writable volume to persist across restarts.
HISTORY_PATH=               # e.g. /var/lib/perspectivegraph/history.json

# ── Remediation ticketing (optional) ─────────────────────────────────
# Turn an attack path into an owned, tracked ticket (closed-loop action). The
# local board (one open ticket per path, with owner + status) persists to
# TICKETS_PATH; empty → in-memory only. Set TICKET_WEBHOOK_URL to also POST each
# new ticket to an external tracker (Jira/GitHub/SOAR); empty → dry-run (the
# ticket is logged and tracked locally only).
TICKETS_PATH=               # e.g. /var/lib/perspectivegraph/tickets.json
TICKET_WEBHOOK_URL=         # e.g. https://hooks.example.com/tickets

# ── Red-team / BAS validation (optional; file-backed) ────────────────
# Verdicts on whether attack paths are real (confirmed / refuted / partial) plus
# the false-negatives a tester found (missed) - the evidence behind the precision
# & recall the dashboard reports. A BAS platform (Caldera/AttackIQ/SafeBreach) or
# a human POSTs to /validations. Empty → in-memory only (lost on restart).
#
# The file is an append-only log: one sealed event per line, compacted periodically,
# so recording a verdict costs the same whether the store holds a hundred or a
# hundred thousand. Existing .json files written by earlier versions still load and
# migrate to the log format on their first write - no manual step. Still one writer:
# keep backend.replicas at 1 while any file-backed store is enabled.
VALIDATIONS_PATH=           # e.g. /var/lib/perspectivegraph/validations.log

# ── Triage / suppression board (optional; file-backed) ───────────────
# Analyst decisions to take a specific attack path off the active board -
# accept-risk / false-positive / mitigating-control / duplicate, each with an
# accountable owner and optional expiry - persist here as JSON. Expired
# suppressions automatically return the path to the active board. Empty → the
# board works but lives in memory only and is lost on restart.
SUPPRESSIONS_PATH=          # e.g. /var/lib/perspectivegraph/suppressions.json

# Where the governance state lives - suppressions, tickets, posture history, red-team
# validations and the KEV holdout.
#
# "file" (default) keeps each in its *_PATH: one writer, so a second replica would
# neither see the first's decisions nor stop overwriting them. "postgres" puts them all
# in POSTGRES_DSN, shared by every replica, with the schema created and upgraded on
# startup under an advisory lock.
#
# The audit log is NOT covered either way: it is a tamper-evident hash chain that stays
# single-writer, which is why the chart still pins backend.replicas to 1.
GOVERNANCE_BACKEND=file     # file | postgres

# ── Drift alerting (optional; chat/SOAR webhook) ─────────────────────
# When a NEW attack path appears between analysis passes, POST an alert.
# format "slack" → {"text": …} (Slack/Mattermost); "generic" → raw drift JSON.
ALERT_WEBHOOK_URL=           # e.g. https://hooks.slack.com/services/...
ALERT_WEBHOOK_FORMAT=slack   # slack | generic

# ── Rate limiting (per client IP; 0 disables) ────────────────────────
# Token-bucket cap on the ingest webhook and the GraphQL API. Generous defaults
# that never throttle `make seed` or the dashboard; lower them at an exposed edge.
INGEST_RATE_RPS=30
API_RATE_RPS=60

# ── Graph core strictness ────────────────────────────────────────────
# When true, the backend refuses to start if Apache AGE is unreachable instead
# of silently falling back to the (non-persistent) in-memory store. Set true for
# any real deployment so a misconfigured DB fails loudly rather than losing data.
GRAPH_STRICT=false

# ── Graph staleness pruning (optional) ───────────────────────────────
# When set, nodes/edges not re-observed within this window are removed, so assets
# that left the source feeds (a deleted pod, a torn-down security group) stop
# producing PHANTOM attack paths. Pruning is leader-only and runs on a derived
# cadence (≈ TTL/6). Elements that predate the stamp (no last_seen) are never
# pruned. Empty/0 disables it. Set it to a few feed-cycles (e.g. 168h = 7d) so a
# briefly-missed scan doesn't evict a still-present asset. OFF by default - the
# demo seeds once and would otherwise prune itself.
GRAPH_TTL=

# ── Secret scrubbing at ingest (data hygiene) ────────────────────────
# Scanner output can incidentally carry a live credential (a hardcoded AWS key in
# a Semgrep snippet, a token on a Falco command line). The graph is a map of how
# to attack the org, so it must never become a STORE of those secrets. When on
# (default), high-precision secret patterns - AWS/GitHub/Slack/Google tokens, PEM
# private keys, JWTs, and `secret=…`/`password=…` assignments - are redacted out
# of ingested property values before they hit the store; the finding is kept, the
# value is replaced with ***redacted:<kind>*** and the node is stamped
# secrets_scrubbed for audit. Identifiers (ids, names, SHAs, digests, refs) are
# never touched. Retention of the scrubbed findings is governed by GRAPH_TTL.
# Set to false only with a deliberate reason.
SCRUB_INGEST=true

# ── Agentless connectors (PULL ingestion) ────────────────────────────
# Push ingestion (POST /ingest/*) needs someone to upload a report. Connectors
# invert that: they reach OUT to an external system on a schedule and feed the
# same bus, so the whole pipeline (identity resolution, graph, analyzer) is
# reused - only the acquisition is new. Leader-only (replicas don't multiply API
# calls). Health is at GET /connectors on the ingest port; metrics at /metrics
# (perspectivegraph_connector_*). Empty = none (ingestion stays push-only).
# Comma-separated, e.g. "aws,azure".
CONNECTORS_ENABLED=
# How often every enabled connector pulls.
CONNECTOR_INTERVAL=15m
# Bounds a single connector's pull so one hung external call can't block the
# others or the schedule.
CONNECTOR_TIMEOUT=2m
# Tenant whose graph the connectors feed (default tenant when empty).
CONNECTOR_TENANT=
# AWS connector. Mode "fixtures" pulls from local describe-* JSON (demo/test, no
# credentials needed - point AWS_FIXTURES_DIR at a dir with cloudnet-sample.json /
# iam-sample.json); mode "sdk" pulls live from AWS via aws-sdk-go-v2 - EC2
# describe-security-groups/instances/vpc-peerings + IAM get-account-authorization-
# details, rendered into the EXACT same cloudnet/iam JSON, so both modes exercise
# identical downstream code. SDK mode uses the standard credential chain (env /
# shared profile / IRSA / instance role); set AWS_ROLE_ARN to assume a read-only
# cross-account role first (the "customer grants you a role" model). Grant only
# read: ec2:Describe*, iam:GetAccountAuthorizationDetails (≈ the AWS-managed
# SecurityAudit / ViewOnlyAccess policies).
# MULTI-ACCOUNT: AWS_ROLE_ARN accepts SEVERAL roles, comma-separated - one per
# account - and each pass pulls all of them. Assets are qualified with the account
# id AWS reports for those credentials (sts:GetCallerIdentity, no extra grant), so
# identifiers that are unique only within an account (i-…, sg-…) stay distinct
# instead of merging two machines into one. An account whose role fails costs that
# account's assets for the pass, not the whole pull. One role, or none, behaves
# exactly as before.
#   AWS_ROLE_ARN=arn:aws:iam::111111111111:role/PerspectiveGraphReadOnly,arn:aws:iam::222222222222:role/PerspectiveGraphReadOnly
AWS_CONNECTOR_MODE=fixtures
AWS_FIXTURES_DIR=
AWS_REGION=
AWS_ROLE_ARN=
# Azure connector. Mode "fixtures" pulls from local normalized Azure JSON (demo/
# test, no credentials needed - point AZURE_FIXTURES_DIR at a dir with azure-
# network-sample.json). Azure's native model differs from the collector shape, so
# each feed is mapped first (NSG rules -> security groups, VMs -> instances, VNet
# peerings -> vpc peerings), then the EXACT same cloudnet collector parses it, so
# fixtures and live exercise identical downstream code. The normalized shape is
# what a small "az network nsg list" / "az vm list -o json" slice produces (with
# the VM->NIC->NSG association resolved). Mode "sdk" (live azure-sdk-for-go) is the
# wired extension point and is not built into this binary yet.
AZURE_CONNECTOR_MODE=fixtures
AZURE_FIXTURES_DIR=

# ── Secrets from files (*_FILE) ──────────────────────────────────────
# Every credential below also accepts a <KEY>_FILE variant holding the PATH to a
# file with the value: INGEST_HMAC_SECRET_FILE, API_TOKENS_FILE,
# POSTGRES_PASSWORD_FILE, STORE_ENCRYPTION_KEY_FILE, EXPORT_SIGNING_KEY_FILE,
# GITHUB_TOKEN_FILE, GITLAB_TOKEN_FILE, ANTHROPIC_API_KEY_FILE, HF_TOKEN_FILE,
# TICKET_WEBHOOK_URL_FILE, ALERT_WEBHOOK_URL_FILE, INGEST_HMAC_SECRETS_FILE.
#
# Prefer them in production. The environment is one of the least private places on
# a Unix host: /proc/<pid>/environ, `docker inspect` (anyone in the docker group),
# crash dumps, and every child process. A mounted file keeps the value out of all
# of them - which is what Docker secrets, a Vault Agent sidecar, and a Kubernetes
# Secret mounted as a volume all give you.
#
#   docker compose -f docker-compose.yml -f docker-compose.secrets.yml up -d
#
# A trailing newline is stripped (secret managers add one); nothing else is
# touched, so a passphrase may begin or end with a space.
#
# A <KEY>_FILE that is set but unreadable is a STARTUP FAILURE, never a silent
# fallback to <KEY> or the default: a mistyped path would otherwise start cleanly
# with no credential, which is the open deployment the mount was meant to prevent.

# ── Metrics on their own port (recommended in production) ────────────
# Empty (default) serves Prometheus /metrics on the API port, which is the
# historical behaviour and declared stable surface. Set this and /metrics moves
# to its own listener and LEAVES the API mux.
#
# Why: several series carry a `tenant` label (analyzer_critical_paths,
# analyzer_graph_nodes, analyzer_graph_edges), so on a reachable API port anyone
# can enumerate tenants and read each one's current posture. Bind this to an
# address the outside cannot reach and scrape it from inside.
#   METRICS_ADDR=127.0.0.1:9090
METRICS_ADDR=

# ── Observability ────────────────────────────────────────────────────
# Prometheus metrics are always exposed at GET /metrics on the API server
# (ingest/normalize/analyzer/dead-letter counters + Go runtime). No config.
#
# NOTE: /metrics is open and unthrottled so a scrape never starves, and it sits
# on the same port as the API. Several series carry a `tenant` label, so anyone
# who can reach that port can enumerate tenants and see how many critical paths
# each has. Scrape from inside the cluster; do not expose the API port directly.
# See docs/THREAT-MODEL.md.

# ── Log level: debug | info | warn | error ───────────────────────────
LOG_LEVEL=info

# ── Log format: text | json ──────────────────────────────────────────
# text is readable in a terminal (the demo default); json is what a log
# pipeline wants. Set json in production - this tool exports to SIEMs, so its
# own logs should be ingestible too.
LOG_FORMAT=text

# Every HTTP request is stamped with an id, echoed in the X-Request-Id response
# header and written into the audit record's fields, so one call can be joined
# across the audit log and the application log. An inbound X-Request-Id from a
# gateway is honoured when it is short and alphanumeric; anything else is
# replaced, because that value is echoed back and logged. No configuration.
